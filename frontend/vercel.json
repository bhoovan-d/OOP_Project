{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "tsc --noEmit && vite build --outDir dist",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://i-itsm-o0ce.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
